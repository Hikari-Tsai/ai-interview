# Server-side jobs only. Never prefix API keys with PUBLIC_.
LLM_API_KEY=
LLM_MODEL=
# An OpenAI-compatible endpoint; omitted uses https://api.openai.com/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_SOURCE_CHAR_LIMIT=30000
LLM_MAX_TOKENS=7000
GENERATION_LIMIT=10
GENERATION_SOURCE_FETCH_LIMIT=10
SOURCE_FETCH_LIMIT=20
# Set both for GitHub project Pages, for example your host and /your-repository.
SITE_URL=http://localhost:4321
BASE_PATH=/

# Optional project repository override; otherwise use site.json or GitHub Actions context.
PROJECT_REPO_URL=
