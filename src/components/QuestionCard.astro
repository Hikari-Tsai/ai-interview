---
import type { Card, Locale } from '../lib/types';
import {type Messages,tagLabel} from '../lib/i18n';
import Icon from './Icon.astro';
import {companyName,companyStyle} from '../lib/companies';
import site from '../config/site.json';
import {pathFor} from '../lib/i18n';
import Sources from './Sources.astro';
import Contribute from './Contribute.astro';
import CommunityCredit from './CommunityCredit.astro';
import {renderCommunityMarkdown} from '../lib/community';
import {renderAnswerText,renderQuestionTitle} from '../lib/prose';
import 'katex/dist/katex.min.css';
const {card,t,locale}=Astro.props as {card:Card;t:Messages;locale:Locale};
const answer=card.answer?.status==='ready'?card.answer.locales[locale]:undefined;
const community=card.community?.[locale];
const answerDate=community?.updatedAt??card.aiGeneratedAt??card.answer?.generatedAt;
const steps=['principle','tradeoff','implementation','production'] as const;
const title=answer?.title||card.original;
const publicSite=Astro.site&&!['localhost','127.0.0.1','[::1]'].includes(Astro.site.hostname);
const shareUrl=publicSite?new URL(pathFor(locale,card.id),Astro.site).href:new URL(`${locale}/questions/${card.id}/`,site.websiteUrl).href;

---
<article class="question-card" data-question={card.id}>
 <div class="card-topline"><span class="question-id">{card.id}</span><span class="card-topic">{tagLabel(t,card.tags[0]||'other')}</span><div class="card-corner"><button type="button" id="share-button" class="share-button" disabled aria-label={t.shareQuestion} title={t.shareQuestion} data-url={shareUrl} data-title={`${card.id} · ${title}`} data-copied={t.shareCopied} data-copy-prompt={t.shareCopyPrompt}><Icon name="share" size={20}/></button></div></div>
 <p id="share-status" class="share-status" role="status" aria-live="polite"></p>
 <div class="question-body">
  <h2 id="question-title" set:html={renderQuestionTitle(title)}/>
  {!answer&&locale!=='en'&&<p class="translation-status">{t.translationPending}</p>}
  {!card.active&&<p class="notice">{t.retired}</p>}
  {card.answer?.status==='stale'&&<p class="notice">{t.stale}</p>}
  <div class="question-tags">{card.tags.map(tag=><button class="tag-pill" type="button" disabled data-hydrate data-add-tag={tag}>{tagLabel(t,tag)}</button>)}</div>
  {locale!=='en'&&answer&&<details class="original-question"><summary>{t.original}<Icon name="chevron" size={14}/></summary><p lang="en">{card.original}</p></details>}
  {card.companies.length>0&&<div class="company-tags" role="group" aria-label={t.company}>{[...new Set(card.companies.map(companyName))].map(company=><button type="button" class="company-tag" style={companyStyle(company)} disabled data-hydrate data-filter-company={company} aria-pressed="false">{company}</button>)}</div>}
 </div>
 <div class="reveal-controls">
  <button type="button" class="button button-quiet" id="hint-button" disabled aria-expanded="false" aria-controls="hint-panel"><Icon name="bulb" size={18}/><span>{t.hint}</span></button>
  <button type="button" class="button button-primary" id="answer-button" disabled aria-expanded="false" aria-controls="answer-panel"><Icon name="eye" size={18}/><span>{t.reveal}</span><Icon name="chevron" size={15}/></button>
 </div>
 <div id="hint-panel" class="hint-panel" hidden>
  <div class="hint-title"><Icon name="bulb" size={18}/><h3>{t.hint}</h3></div>
  {answer ? <><p class="hint-intent">{answer.intent}</p><ol>{answer.hint.map(item=><li>{item}</li>)}</ol></> : <p>{t.pendingHint}</p>}
 </div>
 <div id="answer-panel" hidden>
  {answer ? <div class="answer-body">
   <div class="answer-intro"><p>{community?t.communityAnswer:t.answerTitle}</p><span>{community?t.communityUpdated:t.generated}<time datetime={answerDate}>{new Intl.DateTimeFormat(locale,{year:"numeric",month:"short",day:"numeric"}).format(new Date(answerDate!))}</time></span></div>
   {community&&<CommunityCredit answer={community} locale={locale}/>}
   <div class="answer-roadmap">{steps.map((step,i)=><a href={`#${step}`}><span>{String(i+1).padStart(2,'0')}</span>{t[step].split(' · ')[0]}</a>)}</div>
   {steps.map((step,i)=><section id={step} class="answer-section"><span class="step-number">{String(i+1).padStart(2,'0')}</span><div><h3>{t[step]}</h3><div class={community?'community-prose':'answer-prose'} set:html={community?renderCommunityMarkdown(answer[step]):renderAnswerText(answer[step])}/></div></section>)}
   {community?.advanced&&<details class="community-advanced"><summary>{t.communityAdvanced}</summary><div class="community-prose" set:html={renderCommunityMarkdown(community.advanced)}/></details>}
   {answer.supplementNote&&<p class="supplement-note"><strong>{t.supplement}</strong>{answer.supplementNote}</p>}
  </div> : <div class="pending-answer"><Icon name="book" size={28}/><h3>{t.pendingTitle}</h3><p>{t.pendingDescription}</p></div>}
  <Sources card={card} t={t} locale={locale}/>
 </div>
 <Contribute card={card} locale={locale}/>
 <div class="card-source-strip"><span class="source-dot"></span><a href={card.source.url} target="_blank" rel="noopener noreferrer">{t.originalQuestionLink}<Icon name="external" size={12}/></a><span class="source-separator">/</span><a href={card.source.repo} target="_blank" rel="noopener noreferrer">{t.sourceRepo}</a></div>
</article>
