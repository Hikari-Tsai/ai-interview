---
import type {Locale} from '../lib/types';
import {messages} from '../lib/i18n';
const {locale,title,description,url}=Astro.props as {locale:Locale;title:string;description:string;url:URL};
const image=new URL(`${import.meta.env.BASE_URL.replace(/\/$/,'')}/social/recall-og-v1.jpg`,Astro.site);
const ogLocales:Record<Locale,string>={'zh-TW':'zh_TW',en:'en_US',ja:'ja_JP'};
const alt=messages[locale].socialImageAlt;
---
<meta property="og:type" content="website"/>
<meta property="og:site_name" content="Recall"/>
<meta property="og:title" content={title}/>
<meta property="og:description" content={description}/>
<meta property="og:url" content={url.href}/>
<meta property="og:locale" content={ogLocales[locale]}/>
{Object.entries(ogLocales).filter(([key])=>key!==locale).map(([,value])=><meta property="og:locale:alternate" content={value}/>)}
<meta property="og:image" content={image.href}/>
<meta property="og:image:type" content="image/jpeg"/>
<meta property="og:image:width" content="1200"/>
<meta property="og:image:height" content="630"/>
<meta property="og:image:alt" content={alt}/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:title" content={title}/>
<meta name="twitter:description" content={description}/>
<meta name="twitter:image" content={image.href}/>
<meta name="twitter:image:alt" content={alt}/>
